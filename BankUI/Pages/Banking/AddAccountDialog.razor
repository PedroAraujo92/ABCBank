<MudForm @ref="@_form" Model="CreateAccount">
    <MudDialog>
        <TitleContent>
            Open Bank Account
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" sm="6" md="6">
                    <MudNumericField @bind-Value="CreateAccount.Balance"
                                     Label="Opening Balance"
                                     Margin="Margin.Dense"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudSelect @bind-Value="CreateAccount.Type"
                               Label="Account Type"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined">
                        @foreach (Common.Enums.AccountType type in Enum.GetValues(typeof(Common.Enums.AccountType)))
                        {
                            <MudSelectItem Value="@(type)">@type</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Class="mr-auto">Cancel</MudButton>
            <MudButton Color="Color.Success" Class="me-4" OnClick="SubmitAsync"
                       Variant="Variant.Filled">Save</MudButton>
        </DialogActions>
    </MudDialog>
</MudForm>