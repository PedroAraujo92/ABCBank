<MudForm @ref="@_form" Model="UpdateAccountHolderRequest">
    <MudDialog>
        <TitleContent>
            Edit Account Holder
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="UpdateAccountHolderRequest.Id"
                          Label="Id"
                          Variant="Variant.Outlined"
                          Disabled>
            </MudTextField>
            <MudTextField @bind-Value="UpdateAccountHolderRequest.FirstName"
                          Label="First Name"
                          Variant="Variant.Outlined">
            </MudTextField>
            <MudTextField @bind-Value="UpdateAccountHolderRequest.LastName"
                          Label="Last Name"
                          Variant="Variant.Outlined">
            </MudTextField>
            <MudTextField @bind-Value="UpdateAccountHolderRequest.EmailAddress"
                          Label="Email"
                          Variant="Variant.Outlined">
            </MudTextField>
            <MudTextField @bind-Value="UpdateAccountHolderRequest.ContactNumber"
                          Label="Contact Number"
                          Variant="Variant.Outlined">
            </MudTextField>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
        </DialogActions>
    </MudDialog>
</MudForm>